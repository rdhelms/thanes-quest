{
  // Static hosting for the built game. Deploy with: npm run deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thanes-quest",
  "compatibility_date": "2026-11-01",
  // The game answers at thanes-quest.daventry.io; Cloudflare makes the DNS record and certificate.
  // The workers.dev address stays on beside it (saves are tied to the address they were made at).
  "routes": [{ "pattern": "thanes-quest.daventry.io", "custom_domain": true }],
  "workers_dev": true,
  "assets": { "directory": "./dist" }
}
